# Local stack settings (make stack-up). Not secret; the offline model needs no API key.
# Also read by compose for ${...} interpolation (--env-file).
API_IMAGE=sazon-api:local
WEB_IMAGE=sazon-web:local
CADDY_IMAGE=sazon-caddy:local
DOMAIN=:80
ACME_EMAIL=dev@localhost
ENV=development
SAZON_FAKE_LLM=1
WEB_ORIGIN=http://localhost:8080
MAX_DAILY_LLM_USD=5
RETENTION_DAYS=365
