<!-- A small single-node ClickHouse for Langfuse: smaller caches, quieter logs, and no
     profiling system tables, which otherwise grow by gigabytes a week on an idle server. -->
<clickhouse>
    <mark_cache_size>268435456</mark_cache_size>
    <index_mark_cache_size>67108864</index_mark_cache_size>
    <max_server_memory_usage_to_ram_ratio>0.8</max_server_memory_usage_to_ram_ratio>
    <logger>
        <level>warning</level>
        <console>true</console>
    </logger>
    <query_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </query_log>
    <trace_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <part_log remove="1"/>
    <text_log remove="1"/>
    <processors_profile_log remove="1"/>
    <latency_log remove="1"/>
    <error_log remove="1"/>
</clickhouse>
