# /opt/sazon/observability.env on the VM (mode 600): written once by hand, appended to .env on
# every deploy. Generate the secrets with the commands in deploy/README.md; hex only, because
# some of them go into URLs.
LANGFUSE_DOMAIN=langfuse.example.com
LANGFUSE_URL=https://langfuse.example.com
GRAFANA_DOMAIN=grafana.example.com
GRAFANA_URL=https://grafana.example.com

# Langfuse project keys: the API sends traces with them, Langfuse creates the project with them.
LANGFUSE_PUBLIC_KEY=pk-lf-<hex>
LANGFUSE_SECRET_KEY=sk-lf-<hex>
LANGFUSE_ADMIN_EMAIL=you@example.com
LANGFUSE_ADMIN_PASSWORD=<hex>
LANGFUSE_NEXTAUTH_SECRET=<hex>
LANGFUSE_SALT=<hex>
LANGFUSE_ENCRYPTION_KEY=<64 hex characters>
LANGFUSE_POSTGRES_PASSWORD=<hex>
LANGFUSE_CLICKHOUSE_PASSWORD=<hex>
LANGFUSE_REDIS_PASSWORD=<hex>
LANGFUSE_MINIO_PASSWORD=<hex>

GRAFANA_ADMIN_PASSWORD=<hex>
# Where alerts go: a webhook (Slack, Google Chat...) and/or email through SMTP.
ALERT_WEBHOOK_URL=
ALERT_EMAIL=
GRAFANA_SMTP_ENABLED=false
GRAFANA_SMTP_HOST=
GRAFANA_SMTP_USER=
GRAFANA_SMTP_PASSWORD=
GRAFANA_SMTP_FROM=
