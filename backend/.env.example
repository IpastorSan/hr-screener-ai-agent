# OpenRouter. Zero data retention is always on (every request carries `zdr: true`; there is no
# switch). Set https://eu.openrouter.ai/api/v1 for EU in-region routing (Business plan).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model per role, `vendor/model[@effort]` (effort turns reasoning on). Chosen by the SAZ-24 benchmark:
# evals/results/model_selection.md.
LLM_EXTRACTOR=openrouter:google/gemini-3.5-flash-lite@minimal
LLM_RESPONDER=openrouter:anthropic/claude-haiku-5.5
LLM_SUMMARIZER=openrouter:anthropic/claude-haiku-5.5
# Recruiter assistant ("Preguntar a Ana"); empty uses LLM_RESPONDER.
LLM_ASSISTANT=
LLM_JUDGE=openrouter:anthropic/claude-opus-5.5
LLM_SIMULATOR=

DATABASE_URL=sqlite:///./sazon.db
# Origins allowed to call the API (comma-separated).
WEB_ORIGIN=http://localhost:3000
# 1 runs the API offline: keyword extractor and template replies, no model calls.
SAZON_FAKE_LLM=
# The agent to screen for: one in backend/src/sazon/agents/ by name, or the path of an agent's
# directory (`sazon new-agent` writes one). Empty is riders.
SAZON_AGENT=
# The embedding model and retrieval vectors (`sazon rag-index`); empty is backend/.cache.
SAZON_CACHE_DIR=
# Voice channel (SAZ-16, deploy/README.md "Voice"). ElevenLabs Agents calls
# VOICE_LLM_URL/chat/completions with VOICE_LLM_SECRET as its custom LLM API key.
ELEVENLABS_AGENT_ID=
VOICE_LLM_SECRET=
VOICE_LLM_URL=
# Only for `sazon voice-agent` and conversation tokens of a private agent.
ELEVENLABS_API_KEY=
# https://api.eu.residency.elevenlabs.io for EU data residency (Enterprise).
ELEVENLABS_API_URL=https://api.elevenlabs.io
# Say "Vale... " when a voice reply takes longer than this (seconds); 0 is off.
VOICE_FILLER_AFTER_S=0
# Voice ids per register; empty uses the agent's default voice.
ELEVENLABS_VOICE_ES=
ELEVENLABS_VOICE_MX=
ELEVENLABS_VOICE_EN=
# Eval spend cap in USD, cumulative over every run on this machine: the evals add each paid call
# to evals/results/cost_ledger.jsonl (untracked) and refuse to start a call past the cap.
MAX_EVAL_USD=

# Operations. ENV=production refuses to boot with SAZON_FAKE_LLM on, no OPENROUTER_API_KEY,
# no SESSION_SECRET, or Google configured without TOKEN_ENCRYPTION_KEY.
ENV=development
# Model spend per UTC day; past it new chats get a come-back-later reply and open ones use templates.
MAX_DAILY_LLM_USD=
# Per client IP (X-Forwarded-For from Caddy); 0 turns a limit off.
RATE_LIMIT_CONVERSATIONS_PER_HOUR=20
RATE_LIMIT_MESSAGES_PER_MINUTE=60
# `sazon purge` deletes applications idle for longer than this (the privacy notice says 12 months).
RETENTION_DAYS=365

# Recruiter sign-in. Required with ENV=production (at least 32 characters):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Empty elsewhere: a random key per process, so sessions end when the API restarts.
SESSION_SECRET=
# A session ends after this many hours without a request.
SESSION_TTL_HOURS=12
# Sign-in attempts per 15 minutes, per client IP and per email address.
LOGIN_ATTEMPTS_PER_IP=20
LOGIN_ATTEMPTS_PER_EMAIL=5

# Google sign-in and Calendar (deploy/README.md, "Google sign-in and Calendar"). Both stay off
# without the client id, secret and Workspace domain: sign-in by password, scheduling on working
# hours.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an authorized redirect URI of the OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# Only accounts of this Workspace (the ID token's `hd` claim) can sign in with Google. Empty by
# default.
GOOGLE_WORKSPACE_DOMAIN=
# Fernet key for the stored refresh tokens; required with ENV=production when Google is on:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Empty elsewhere: a random key per process, so calendars must be connected again after a restart.
TOKEN_ENCRYPTION_KEY=
# google: recruiters' calendars (free/busy + an event per booking); fixed: working hours only;
# fake: an in-memory calendar for demos (every active recruiter counts as connected).
SCHEDULING_SOURCE=fixed
# Free minutes before and after each interview; days ahead that interview times are offered.
INTERVIEW_BUFFER_MINUTES=10
SCHEDULING_DAYS=14
# In-person interviews are with each location's manager. Their invitations are sent from this
# recruiter account's calendar (the candidate and the manager as guests); it must exist and,
# with SCHEDULING_SOURCE=google, have its calendar connected, or in person is not offered.
ONSITE_ORGANIZER_EMAIL=
# The API's public HTTPS origin. With SCHEDULING_SOURCE=google it turns on Google Calendar push
# notifications to $PUBLIC_URL/api/webhooks/google/calendar (locally, a cloudflared tunnel URL).
PUBLIC_URL=
# How long a push channel lives; `sazon calendar-watch renew` (daily) replaces it before then.
CALENDAR_WATCH_TTL_HOURS=168

# Observability (deploy/README.md). Tracing stays off without an OTLP endpoint.
# Langfuse: http://langfuse-web:3000/api/public/otel with the project's keys as basic auth.
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# false keeps prompts, replies and candidate text out of traces (only metadata, timings, cost).
TRACE_CONTENT=true
# json or text; empty means json with ENV=production.
LOG_FORMAT=
